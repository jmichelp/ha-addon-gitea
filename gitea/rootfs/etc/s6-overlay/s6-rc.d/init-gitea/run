        sub_filter '"StaticUrlPrefix": ""' '"StaticUrlPrefix": "\$http_x_ingress_path"';
        sub_filter '"StaticUrlPrefix":""' '"StaticUrlPrefix":"\$http_x_ingress_path"';
        sub_filter 'assetUrlPrefix: "/assets"' 'assetUrlPrefix: "\$http_x_ingress_path/assets"';
