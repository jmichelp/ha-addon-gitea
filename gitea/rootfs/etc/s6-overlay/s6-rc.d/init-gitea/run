#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Add-on: Gitea
# Initialization script for Gitea
# ==============================================================================

umask 0022

bashio::log.info "Initializing Gitea environment..."

# Ensure required directories exist
mkdir -p \
    /data/gitea/conf \
    /data/gitea/data \
    /data/gitea/log \
    /data/gitea/ssh \
    /data/git/repositories \
    /data/git/.ssh \
    /run/nginx \
    /var/log/nginx \
    /var/lib/nginx \
    /etc/nginx/http.d

# Link options (licenses, gitignore templates) if directory exists
if [ -d /usr/share/webapps/gitea/options ] && [ ! -e /data/gitea/options ]; then
    ln -sfn /usr/share/webapps/gitea/options /data/gitea/options 2>/dev/null || true
fi

# Remove dangling symlinks created in earlier versions
if [ -L /data/gitea/public ] && [ ! -e /data/gitea/public ]; then
    rm -f /data/gitea/public 2>/dev/null || true
fi
if [ -L /data/gitea/templates ] && [ ! -e /data/gitea/templates ]; then
    rm -f /data/gitea/templates 2>/dev/null || true
fi

# Ensure directory permissions are 755
chmod 755 /data/gitea /data/gitea/conf /data/gitea/data /data/gitea/log /data/gitea/ssh /data/git /data/git/repositories /data/git/.ssh 2>/dev/null || true

# Calculate configuration parameters
bashio::config.require 'domain'
bashio::config.require 'ssl'

DOMAIN=$(bashio::config 'domain')
SSH_PORT=$(bashio::addon.port 2222)
if [ -z "${SSH_PORT}" ]; then
    SSH_PORT=3022
fi
WEB_PORT=$(bashio::addon.port 3000)
if [ -z "${WEB_PORT}" ]; then
    WEB_PORT=3000
fi

# Determine protocol and ROOT_URL for external access
if bashio::config.has_value 'root_url'; then
    ROOT_URL=$(bashio::config 'root_url')
    bashio::log.info "Using configured ROOT_URL: ${ROOT_URL}"
elif bashio::config.true 'use_nginx'; then
    ROOT_URL="https://${DOMAIN}/"
    bashio::log.info "Nginx reverse proxy is active, defaulting ROOT_URL: ${ROOT_URL}"
elif bashio::config.true 'ssl'; then
    ROOT_URL="https://${DOMAIN}:${WEB_PORT}/"
    bashio::log.info "Direct SSL active, defaulting ROOT_URL: ${ROOT_URL}"
else
    ROOT_URL="http://${DOMAIN}:${WEB_PORT}/"
    bashio::log.info "Defaulting ROOT_URL: ${ROOT_URL}"
fi

# Setup default app.ini if not existing or empty
if [ ! -s /data/gitea/conf/app.ini ]; then
    bashio::log.info "Creating initial Gitea configuration (app.ini)..."
    cat <<EOF > /data/gitea/conf/app.ini
APP_NAME = Gitea: Git with a cup of tea
RUN_USER = git
WORK_PATH = /data/gitea
RUN_MODE = prod

[repository]
ROOT = /data/git/repositories
DEFAULT_BRANCH = main

[server]
APP_DATA_PATH = /data/gitea/data
DOMAIN = ${DOMAIN}
SSH_DOMAIN = ${DOMAIN}
HTTP_ADDR = 127.0.0.1
HTTP_PORT = 3001
ROOT_URL = ${ROOT_URL}
DISABLE_SSH = false
START_SSH_SERVER = true
SSH_PORT = ${SSH_PORT}
SSH_LISTEN_PORT = 2222
SSH_KEYGEN_PATH = /usr/bin/ssh-keygen
SSH_ROOT_PATH = /data/gitea/ssh
LFS_START_SERVER = true
OFFLINE_MODE = false
ENABLE_GZIP = true

[database]
DB_TYPE = sqlite3
PATH = /data/gitea/data/gitea.db
SQLITE_JOURNAL_MODE = WAL
SQLITE_TIMEOUT = 20000

[security]
INSTALL_LOCK = true
SECRET_KEY = 
INTERNAL_TOKEN = 

[service]
DISABLE_REGISTRATION = false
REQUIRE_SIGNIN_VIEW = false
REGISTER_EMAIL_CONFIRM = false
ENABLE_NOTIFY_MAIL = false
DISABLE_GRAVATAR = false
ENABLE_FEDERATED_AVATAR = false

[cache]
ADAPTER = memory
INTERVAL = 60

[session]
PROVIDER = memory

[log]
MODE = console
LEVEL = Info

[lfs]
PATH = /data/gitea/data/lfs
EOF
else
    # Update existing app.ini with current domain, ports, ROOT_URL, and optimizations
    sed -i '/STATIC_ROOT_PATH/d' /data/gitea/conf/app.ini
    sed -i "s|^HTTP_PORT = .*|HTTP_PORT = 3001|" /data/gitea/conf/app.ini
    sed -i "s|^HTTP_ADDR = .*|HTTP_ADDR = 127.0.0.1|" /data/gitea/conf/app.ini
    sed -i "s|^ROOT_URL = .*|ROOT_URL = ${ROOT_URL}|" /data/gitea/conf/app.ini
    sed -i "s|^DOMAIN = .*|DOMAIN = ${DOMAIN}|" /data/gitea/conf/app.ini
    sed -i "s|^SSH_DOMAIN = .*|SSH_DOMAIN = ${DOMAIN}|" /data/gitea/conf/app.ini
    sed -i "s|^SSH_PORT = .*|SSH_PORT = ${SSH_PORT}|" /data/gitea/conf/app.ini
    sed -i "s|^SSH_LISTEN_PORT = .*|SSH_LISTEN_PORT = 2222|" /data/gitea/conf/app.ini

    if ! grep -q "^HTTP_ADDR" /data/gitea/conf/app.ini; then
        sed -i '/\[server\]/a HTTP_ADDR = 127.0.0.1' /data/gitea/conf/app.ini
    fi
    if ! grep -q "^ROOT_URL" /data/gitea/conf/app.ini; then
        sed -i "/\[server\]/a ROOT_URL = ${ROOT_URL}" /data/gitea/conf/app.ini
    fi
    if ! grep -q "ENABLE_GZIP" /data/gitea/conf/app.ini; then
        sed -i '/\[server\]/a ENABLE_GZIP = true' /data/gitea/conf/app.ini
    fi
    if ! grep -q "SQLITE_JOURNAL_MODE" /data/gitea/conf/app.ini; then
        sed -i '/\[database\]/a SQLITE_JOURNAL_MODE = WAL' /data/gitea/conf/app.ini
    fi
    if grep -q "ENABLE_FEDERATED_AVATAR" /data/gitea/conf/app.ini; then
        sed -i 's/^ENABLE_FEDERATED_AVATAR = .*/ENABLE_FEDERATED_AVATAR = false/' /data/gitea/conf/app.ini
    else
        sed -i '/\[service\]/a ENABLE_FEDERATED_AVATAR = false' /data/gitea/conf/app.ini
    fi
    if grep -q "DISABLE_GRAVATAR" /data/gitea/conf/app.ini; then
        sed -i 's/^DISABLE_GRAVATAR = .*/DISABLE_GRAVATAR = false/' /data/gitea/conf/app.ini
    fi
    if ! grep -q "^\[cache\]" /data/gitea/conf/app.ini; then
        cat <<'EOF' >> /data/gitea/conf/app.ini

[cache]
ADAPTER = memory
INTERVAL = 60
EOF
    fi
    if ! grep -q "^\[session\]" /data/gitea/conf/app.ini; then
        cat <<'EOF' >> /data/gitea/conf/app.ini

[session]
PROVIDER = memory
EOF
    fi
fi

# Ensure SQLite database runs in WAL mode with normal sync for high performance
if [ -f /data/gitea/data/gitea.db ]; then
    sqlite3 /data/gitea/data/gitea.db "PRAGMA journal_mode=WAL; PRAGMA synchronous=NORMAL;" 2>/dev/null || true
fi

# Secure sensitive configuration and SSH keys
chmod 640 /data/gitea/conf/app.ini 2>/dev/null || true
chmod 700 /data/git/.ssh /data/gitea/ssh 2>/dev/null || true
find /data/git/.ssh /data/gitea/ssh -type f -exec chmod 600 {} + 2>/dev/null || true

# Ensure all Gitea data is owned by git:git
chown -R git:git /data/gitea /data/git /app/gitea 2>/dev/null || true

# Configure Direct Web SSL if enabled
if bashio::config.true 'ssl' && ! bashio::config.true 'use_nginx'; then
    CERT_FILE="/ssl/$(bashio::config 'certfile')"
    KEY_FILE="/ssl/$(bashio::config 'keyfile')"
    if [ ! -f "${CERT_FILE}" ]; then
        bashio::exit.nok "Certificate file ${CERT_FILE} does not exist!"
    fi
    if [ ! -f "${KEY_FILE}" ]; then
        bashio::exit.nok "Key file ${KEY_FILE} does not exist!"
    fi
    DIRECT_LISTEN="listen 3000 ssl;
    http2 on;
    ssl_certificate ${CERT_FILE};
    ssl_certificate_key ${KEY_FILE};"
else
    DIRECT_LISTEN="listen 3000;"
fi

# Ensure Nginx runs properly without permission drops
sed -i 's/^user .*/user root;/' /etc/nginx/nginx.conf 2>/dev/null || true

# Configure internal NGINX for Ingress (8099) and Direct/Custom Domain (3000)
rm -f /etc/nginx/http.d/default.conf 2>/dev/null || true
cat <<EOF > /etc/nginx/http.d/gitea.conf
# Upstream definition with persistent keepalive connections
upstream gitea_backend {
    server 127.0.0.1:3001;
    keepalive 64;
}

# WebSocket upgrade mapping with unique variable name
map \$http_upgrade \$gitea_connection_upgrade {
    default upgrade;
    ''      '';
}

# Ingress scheme and host mappings
map \$http_x_forwarded_proto \$ingress_proto {
    default \$http_x_forwarded_proto;
    ''      https;
}

map \$http_x_forwarded_host \$ingress_host {
    default \$http_x_forwarded_host;
    ''      \$host;
}

# Direct access scheme and host mappings
map \$http_x_forwarded_proto \$direct_proto {
    default \$http_x_forwarded_proto;
    ''      \$scheme;
}

map \$http_x_forwarded_host \$direct_host {
    default \$http_x_forwarded_host;
    ''      \$host;
}

# Home Assistant Ingress endpoint
server {
    listen 8099 default_server;

    allow 127.0.0.1;
    allow 172.30.32.2;
    deny all;

    client_max_body_size 512M;

    # Static assets caching without sub_filter processing
    location ^~ /assets/ {
        proxy_pass http://gitea_backend;
        proxy_http_version 1.1;

        proxy_set_header Connection \$gitea_connection_upgrade;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Host \$ingress_host;
        proxy_set_header X-Forwarded-Host \$ingress_host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$ingress_proto;

        proxy_buffering off;
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
    }

    location / {
        proxy_pass http://gitea_backend;
        proxy_http_version 1.1;

        proxy_set_header Accept-Encoding "";
        proxy_set_header Host \$ingress_host;
        proxy_set_header X-Forwarded-Host \$ingress_host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$ingress_proto;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$gitea_connection_upgrade;

        proxy_buffering off;

        sub_filter_once off;
        sub_filter_types text/html;
        sub_filter 'http://\$http_host/' '\$ingress_proto://\$ingress_host\$http_x_ingress_path/';
        sub_filter 'https://\$http_host/' '\$ingress_proto://\$ingress_host\$http_x_ingress_path/';
        sub_filter 'http://\$host:8099/' '\$ingress_proto://\$ingress_host\$http_x_ingress_path/';
        sub_filter 'https://\$host:8099/' '\$ingress_proto://\$ingress_host\$http_x_ingress_path/';
        sub_filter 'http://\$host/' '\$ingress_proto://\$ingress_host\$http_x_ingress_path/';
        sub_filter 'href="/' 'href="\$http_x_ingress_path/';
        sub_filter 'src="/' 'src="\$http_x_ingress_path/';
        sub_filter 'action="/' 'action="\$http_x_ingress_path/';
        sub_filter 'data-url="/' 'data-url="\$http_x_ingress_path/';
        sub_filter '"/assets/' '"\$http_x_ingress_path/assets/';
        sub_filter '"/user/' '"\$http_x_ingress_path/user/';
        sub_filter '"/repo/' '"\$http_x_ingress_path/repo/';
        sub_filter '"/api/' '"\$http_x_ingress_path/api/';
        sub_filter '"/avatar/' '"\$http_x_ingress_path/avatar/';
        sub_filter "appSubUrl: ''" "appSubUrl: '\$http_x_ingress_path'";

        proxy_redirect http://\$http_host/ \$http_x_ingress_path/;
        proxy_redirect https://\$http_host/ \$http_x_ingress_path/;
        proxy_redirect http://\$host:8099/ \$http_x_ingress_path/;
        proxy_redirect https://\$host:8099/ \$http_x_ingress_path/;
        proxy_redirect / \$http_x_ingress_path/;
    }
}

# Direct Web / External Reverse Proxy endpoint
server {
    ${DIRECT_LISTEN}

    client_max_body_size 512M;

    # Static assets caching
    location ^~ /assets/ {
        proxy_pass http://gitea_backend;
        proxy_http_version 1.1;

        proxy_set_header Connection \$gitea_connection_upgrade;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Host \$direct_host;
        proxy_set_header X-Forwarded-Host \$direct_host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$direct_proto;

        proxy_buffering off;
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
    }

    location / {
        proxy_pass http://gitea_backend;
        proxy_http_version 1.1;

        proxy_set_header Connection \$gitea_connection_upgrade;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Host \$direct_host;
        proxy_set_header X-Forwarded-Host \$direct_host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$direct_proto;

        proxy_buffering off;
        proxy_request_buffering off;
    }
}
EOF

# Configure external Nginx reverse proxy integration if enabled
if bashio::config.true "use_nginx"; then
    DOMAIN=$(bashio::config 'domain')
    PORT=$(bashio::addon.port 3000)
    if [ -z "${PORT}" ]; then
        PORT=3000
    fi
    bashio::log.info "Configuring Nginx reverse proxy integration for domain ${DOMAIN} (forwarding to 127.0.0.1:${PORT})..."
    mkdir -p /share/nginx_proxy
    sed "s/__DOMAIN__/${DOMAIN}/g; s/__GITEA_PORT__/${PORT}/g" /app/nginx_gitea.conf > /share/nginx_proxy/nginx_gitea.conf
fi
