        sub_filter 'AssetUrlPrefix: "/assets"' 'AssetUrlPrefix: "\$http_x_ingress_path/assets"';
        sub_filter "AssetUrlPrefix: '/assets'" "AssetUrlPrefix: '\$http_x_ingress_path/assets'";
        sub_filter '"assetUrlPrefix": "/assets"' '"assetUrlPrefix": "\$http_x_ingress_path/assets"';
        sub_filter '"assetUrlPrefix":"/assets"' '"assetUrlPrefix":"\$http_x_ingress_path/assets"';
        sub_filter '"AssetUrlPrefix": "/assets"' '"AssetUrlPrefix": "\$http_x_ingress_path/assets"';
        sub_filter '"AssetUrlPrefix":"/assets"' '"AssetUrlPrefix":"\$http_x_ingress_path/assets"';
        sub_filter 'customUrlPrefix: "/custom"' 'customUrlPrefix: "\$http_x_ingress_path/custom"';
        sub_filter "customUrlPrefix: '/custom'" "customUrlPrefix: '\$http_x_ingress_path/custom'";
        sub_filter 'CustomUrlPrefix: "/custom"' 'CustomUrlPrefix: "\$http_x_ingress_path/custom"';
        sub_filter "CustomUrlPrefix: '/custom'" "CustomUrlPrefix: '\$http_x_ingress_path/custom'";
        sub_filter '"customUrlPrefix": "/custom"' '"customUrlPrefix": "\$http_x_ingress_path/custom"';
        sub_filter '"customUrlPrefix":"/custom"' '"customUrlPrefix":"\$http_x_ingress_path/custom"';
        sub_filter '"CustomUrlPrefix": "/custom"' '"CustomUrlPrefix": "\$http_x_ingress_path/custom"';
        sub_filter '"CustomUrlPrefix":"/custom"' '"CustomUrlPrefix":"\$http_x_ingress_path/custom"';

        proxy_cookie_path / \$http_x_ingress_path/;
        proxy_redirect http://\$http_host/ \$http_x_ingress_path/;
        proxy_redirect https://\$http_host/ \$http_x_ingress_path/;
        proxy_redirect http://\$host:8099/ \$http_x_ingress_path/;
        proxy_redirect https://\$host:8099/ \$http_x_ingress_path/;
        proxy_redirect http://\$host/ \$http_x_ingress_path/;
        proxy_redirect https://\$host/ \$http_x_ingress_path/;
        proxy_redirect http://${DOMAIN}:${WEB_PORT}/ \$http_x_ingress_path/;
        proxy_redirect https://${DOMAIN}:${WEB_PORT}/ \$http_x_ingress_path/;
        proxy_redirect http://${DOMAIN}/ \$http_x_ingress_path/;
        proxy_redirect https://${DOMAIN}/ \$http_x_ingress_path/;
        proxy_redirect http://127.0.0.1:3001/ \$http_x_ingress_path/;
        proxy_redirect http://gitea_backend/ \$http_x_ingress_path/;
        proxy_redirect http://localhost:3001/ \$http_x_ingress_path/;
        proxy_redirect ${ROOT_URL} \$http_x_ingress_path/;
        proxy_redirect / \$http_x_ingress_path/;
    }
}

# Direct Web / External Reverse Proxy endpoint
server {
    ${DIRECT_LISTEN}

    absolute_redirect off;
    port_in_redirect off;

    client_max_body_size 512M;
    proxy_buffer_size 128k;
    proxy_buffers 4 256k;
    proxy_busy_buffers_size 256k;
    proxy_temp_file_write_size 256k;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;

        proxy_set_header Connection \$gitea_connection_upgrade;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Host \$direct_host;
        proxy_set_header X-Forwarded-Host \$direct_host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$direct_proto;

        proxy_connect_timeout 90;
        proxy_send_timeout 300;
        proxy_read_timeout 300;
    }
}
EOF

# Configure external Nginx reverse proxy integration if enabled
if bashio::config.true "use_nginx"; then
    DOMAIN=$(bashio::config 'domain')
    PORT=$(bashio::addon.port 3000)
    if [ -z "${PORT}" ]; then
        PORT=3000
    fi
    bashio::log.info "Configuring Nginx reverse proxy integration for domain ${DOMAIN} (forwarding to 127.0.0.1:${PORT})..."
    mkdir -p /share/nginx_proxy
    sed "s/__DOMAIN__/${DOMAIN}/g; s/__GITEA_PORT__/${PORT}/g" /app/nginx_gitea.conf > /share/nginx_proxy/nginx_gitea.conf
fi
