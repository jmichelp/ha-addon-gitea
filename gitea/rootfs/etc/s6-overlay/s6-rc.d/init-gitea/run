#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Add-on: Gitea
# Initialization script for Gitea
# ==============================================================================

umask 0022

bashio::log.info "Initializing Gitea environment..."

# Ensure required directories exist
mkdir -p \
    /data/gitea/conf \
    /data/gitea/data \
    /data/gitea/data/lfs \
    /data/gitea/log \
    /data/gitea/ssh \
    /data/git/repositories \
    /data/git/.ssh \
    /run/nginx \
    /run/sshd \
    /var/empty \
    /etc/ssh \
    /var/log/nginx \
    /var/lib/nginx \
    /etc/nginx/http.d

# Link options (licenses, gitignore templates) if directory exists
if [ -d /usr/share/webapps/gitea/options ] && [ ! -e /data/gitea/options ]; then
    ln -sfn /usr/share/webapps/gitea/options /data/gitea/options 2>/dev/null || true
fi

# Remove dangling symlinks created in earlier versions
if [ -L /data/gitea/public ] && [ ! -e /data/gitea/public ]; then
    rm -f /data/gitea/public 2>/dev/null || true
fi
if [ -L /data/gitea/templates ] && [ ! -e /data/gitea/templates ]; then
    rm -f /data/gitea/templates 2>/dev/null || true
fi

# Ensure directory permissions are 755
chmod 755 /data/gitea /data/gitea/conf /data/gitea/data /data/gitea/log /data/gitea/ssh /data/git /data/git/repositories /data/git/.ssh /run/sshd /var/empty 2>/dev/null || true

# Generate SSH Host Keys in /data/gitea/ssh/ for OpenSSH server persistence
if [ ! -f /data/gitea/ssh/ssh_host_ed25519_key ]; then
    bashio::log.info "Generating SSH ed25519 host key..."
    ssh-keygen -t ed25519 -N "" -f /data/gitea/ssh/ssh_host_ed25519_key >/dev/null 2>&1 || true
fi
if [ ! -f /data/gitea/ssh/ssh_host_rsa_key ]; then
    bashio::log.info "Generating SSH RSA host key..."
    ssh-keygen -t rsa -b 4096 -N "" -f /data/gitea/ssh/ssh_host_rsa_key >/dev/null 2>&1 || true
fi
if [ ! -f /data/gitea/ssh/ssh_host_ecdsa_key ]; then
    bashio::log.info "Generating SSH ECDSA host key..."
    ssh-keygen -t ecdsa -b 521 -N "" -f /data/gitea/ssh/ssh_host_ecdsa_key >/dev/null 2>&1 || true
fi
chmod 600 /data/gitea/ssh/ssh_host_*_key 2>/dev/null || true
chmod 644 /data/gitea/ssh/ssh_host_*.pub 2>/dev/null || true

# Generate /etc/ssh/sshd_config for OpenSSH mode
cat <<'EOF' > /etc/ssh/sshd_config
Port 2222
ListenAddress 0.0.0.0
HostKey /data/gitea/ssh/ssh_host_ed25519_key
HostKey /data/gitea/ssh/ssh_host_rsa_key
HostKey /data/gitea/ssh/ssh_host_ecdsa_key
AuthorizedKeysFile /data/git/.ssh/authorized_keys
AllowUsers git
PasswordAuthentication no
PubkeyAuthentication yes
ChallengeResponseAuthentication no
KbdInteractiveAuthentication no
UsePAM no
PrintMotd no
AcceptEnv GIT_PROTOCOL
Subsystem sftp /usr/lib/ssh/sftp-server
EOF

# Ensure git user authorized_keys file exists and is linked
touch /data/git/.ssh/authorized_keys
chmod 600 /data/git/.ssh/authorized_keys
chmod 700 /data/git/.ssh
ln -sf /data/git/.ssh/authorized_keys /data/gitea/ssh/authorized_keys 2>/dev/null || touch /data/gitea/ssh/authorized_keys
chmod 600 /data/gitea/ssh/authorized_keys 2>/dev/null || true
chmod 700 /data/gitea/ssh

# Calculate configuration parameters
bashio::config.require 'domain'
bashio::config.require 'ssl'

DOMAIN=$(bashio::config 'domain')
SSH_PORT=$(bashio::addon.port 2222)
if [ -z "${SSH_PORT}" ]; then
    SSH_PORT=3022
fi
WEB_PORT=$(bashio::addon.port 3000)
if [ -z "${WEB_PORT}" ]; then
    WEB_PORT=3000
fi

# Determine protocol and ROOT_URL for external access
if bashio::config.has_value 'root_url'; then
    ROOT_URL=$(bashio::config 'root_url')
    bashio::log.info "Using configured ROOT_URL: ${ROOT_URL}"
elif bashio::config.true 'use_nginx'; then
    ROOT_URL="https://${DOMAIN}/"
    bashio::log.info "Nginx reverse proxy is active, defaulting ROOT_URL: ${ROOT_URL}"
elif bashio::config.true 'ssl'; then
    ROOT_URL="https://${DOMAIN}:${WEB_PORT}/"
    bashio::log.info "Direct SSL active, defaulting ROOT_URL: ${ROOT_URL}"
else
    ROOT_URL="http://${DOMAIN}:${WEB_PORT}/"
    bashio::log.info "Defaulting ROOT_URL: ${ROOT_URL}"
fi

RP_ORIGIN="${ROOT_URL%/}"

# Determine SSH server mode
if bashio::config.equals 'ssh_server' 'openssh'; then
    START_SSH_SERVER="false"
    bashio::log.info "SSH Server mode: OpenSSH daemon"
else
    START_SSH_SERVER="true"
    bashio::log.info "SSH Server mode: Gitea embedded SSH server"
fi

# Password policy
PASSWORD_CHECK_PWN="false"
if bashio::config.true 'password_check_pwn'; then
    PASSWORD_CHECK_PWN="true"
fi

# Registration and access policies
DISABLE_REGISTRATION="false"
if bashio::config.true 'disable_registration'; then
    DISABLE_REGISTRATION="true"
fi

REQUIRE_SIGNIN_VIEW="false"
if bashio::config.true 'require_signin_view'; then
    REQUIRE_SIGNIN_VIEW="true"
fi

# Mailer configuration
MAILER_ENABLED="false"
MAILER_PROTOCOL="starttls"
MAILER_SMTP_ADDR=""
MAILER_SMTP_PORT="587"
MAILER_USER=""
MAILER_PASSWORD=""
MAILER_FROM=""
MAILER_HELO_HOSTNAME=""
MAILER_FORCE_TRUST_CERT="false"
REGISTER_EMAIL_CONFIRM="false"

if bashio::config.true 'mailer_enabled'; then
    MAILER_ENABLED="true"
    if bashio::config.has_value 'mailer_protocol'; then
        MAILER_PROTOCOL=$(bashio::config 'mailer_protocol')
    fi
    if bashio::config.has_value 'mailer_smtp_addr'; then
        MAILER_SMTP_ADDR=$(bashio::config 'mailer_smtp_addr')
    fi
    if bashio::config.has_value 'mailer_smtp_port'; then
        MAILER_SMTP_PORT=$(bashio::config 'mailer_smtp_port')
    fi
    if bashio::config.has_value 'mailer_user'; then
        MAILER_USER=$(bashio::config 'mailer_user')
    fi
    if bashio::config.has_value 'mailer_password'; then
        MAILER_PASSWORD=$(bashio::config 'mailer_password')
    fi
    if bashio::config.has_value 'mailer_from'; then
        MAILER_FROM=$(bashio::config 'mailer_from')
    fi
    if bashio::config.has_value 'mailer_helo_hostname'; then
        MAILER_HELO_HOSTNAME=$(bashio::config 'mailer_helo_hostname')
    fi
    if bashio::config.true 'mailer_force_trust_cert'; then
        MAILER_FORCE_TRUST_CERT="true"
    fi
    if bashio::config.true 'register_email_confirm'; then
        REGISTER_EMAIL_CONFIRM="true"
    fi
fi

# CAPTCHA configuration
CAPTCHA_ENABLED="false"
CAPTCHA_TYPE="image"
CAPTCHA_FOR_LOGIN="false"
RECAPTCHA_SITEKEY=""
RECAPTCHA_SECRET=""
RECAPTCHA_URL="https://www.google.com/recaptcha/"
HCAPTCHA_SITEKEY=""
HCAPTCHA_SECRET=""
MCAPTCHA_SITEKEY=""
MCAPTCHA_SECRET=""
MCAPTCHA_URL="https://demo.mcaptcha.org/"
CF_TURNSTILE_SITEKEY=""
CF_TURNSTILE_SECRET=""

if bashio::config.true 'captcha_enabled'; then
    CAPTCHA_ENABLED="true"
    if bashio::config.has_value 'captcha_type'; then
        CAPTCHA_TYPE=$(bashio::config 'captcha_type')
    fi
    if bashio::config.true 'captcha_for_login'; then
        CAPTCHA_FOR_LOGIN="true"
    fi
    if bashio::config.has_value 'recaptcha_sitekey'; then
        RECAPTCHA_SITEKEY=$(bashio::config 'recaptcha_sitekey')
    fi
    if bashio::config.has_value 'recaptcha_secret'; then
        RECAPTCHA_SECRET=$(bashio::config 'recaptcha_secret')
    fi
    if bashio::config.has_value 'recaptcha_url'; then
        RECAPTCHA_URL=$(bashio::config 'recaptcha_url')
    fi
    if bashio::config.has_value 'hcaptcha_sitekey'; then
        HCAPTCHA_SITEKEY=$(bashio::config 'hcaptcha_sitekey')
    fi
    if bashio::config.has_value 'hcaptcha_secret'; then
        HCAPTCHA_SECRET=$(bashio::config 'hcaptcha_secret')
    fi
    if bashio::config.has_value 'mcaptcha_sitekey'; then
        MCAPTCHA_SITEKEY=$(bashio::config 'mcaptcha_sitekey')
    fi
    if bashio::config.has_value 'mcaptcha_secret'; then
        MCAPTCHA_SECRET=$(bashio::config 'mcaptcha_secret')
    fi
    if bashio::config.has_value 'mcaptcha_url'; then
        MCAPTCHA_URL=$(bashio::config 'mcaptcha_url')
    fi
    if bashio::config.has_value 'cf_turnstile_sitekey'; then
        CF_TURNSTILE_SITEKEY=$(bashio::config 'cf_turnstile_sitekey')
    fi
    if bashio::config.has_value 'cf_turnstile_secret'; then
        CF_TURNSTILE_SECRET=$(bashio::config 'cf_turnstile_secret')
    fi
fi

# Generate unique secret files in /data/gitea/conf/ (for HA backup retention)
if [ ! -f /data/gitea/conf/secret_key ]; then
    bashio::log.info "Generating secret key file (/data/gitea/conf/secret_key)..."
    if [ -f /data/gitea/conf/app.ini ] && grep -q "^SECRET_KEY =" /data/gitea/conf/app.ini; then
        existing_key=$(grep "^SECRET_KEY =" /data/gitea/conf/app.ini | cut -d= -f2- | tr -d ' \r\n')
        if [ -n "${existing_key}" ]; then
            printf "%s" "${existing_key}" > /data/gitea/conf/secret_key
        fi
    fi
    if [ ! -s /data/gitea/conf/secret_key ]; then
        /usr/bin/gitea generate secret SECRET_KEY > /data/gitea/conf/secret_key 2>/dev/null || tr -dc 'a-zA-Z0-9' < /dev/urandom | head -c 64 > /data/gitea/conf/secret_key
    fi
fi
chmod 600 /data/gitea/conf/secret_key 2>/dev/null || true
chown git:git /data/gitea/conf/secret_key 2>/dev/null || true

if [ ! -f /data/gitea/conf/internal_token ]; then
    bashio::log.info "Generating internal token file (/data/gitea/conf/internal_token)..."
    if [ -f /data/gitea/conf/app.ini ] && grep -q "^INTERNAL_TOKEN =" /data/gitea/conf/app.ini; then
        existing_token=$(grep "^INTERNAL_TOKEN =" /data/gitea/conf/app.ini | cut -d= -f2- | tr -d ' \r\n')
        if [ -n "${existing_token}" ]; then
            printf "%s" "${existing_token}" > /data/gitea/conf/internal_token
        fi
    fi
    if [ ! -s /data/gitea/conf/internal_token ]; then
        /usr/bin/gitea generate secret INTERNAL_TOKEN > /data/gitea/conf/internal_token 2>/dev/null || tr -dc 'a-zA-Z0-9' < /dev/urandom | head -c 64 > /data/gitea/conf/internal_token
    fi
fi
chmod 600 /data/gitea/conf/internal_token 2>/dev/null || true
chown git:git /data/gitea/conf/internal_token 2>/dev/null || true

if [ ! -s /data/gitea/conf/jwt_secret ]; then
    bashio::log.info "Generating JWT secret file (/data/gitea/conf/jwt_secret)..."
    /usr/bin/gitea generate secret JWT_SECRET > /data/gitea/conf/jwt_secret 2>/dev/null || tr -dc 'a-zA-Z0-9' < /dev/urandom | head -c 64 > /data/gitea/conf/jwt_secret
fi
chmod 600 /data/gitea/conf/jwt_secret 2>/dev/null || true
chown git:git /data/gitea/conf/jwt_secret 2>/dev/null || true

if [ ! -s /data/gitea/conf/lfs_jwt_secret ]; then
    bashio::log.info "Generating LFS JWT secret file (/data/gitea/conf/lfs_jwt_secret)..."
    /usr/bin/gitea generate secret JWT_SECRET > /data/gitea/conf/lfs_jwt_secret 2>/dev/null || tr -dc 'a-zA-Z0-9' < /dev/urandom | head -c 64 > /data/gitea/conf/lfs_jwt_secret
fi
chmod 600 /data/gitea/conf/lfs_jwt_secret 2>/dev/null || true
chown git:git /data/gitea/conf/lfs_jwt_secret 2>/dev/null || true

# Extract raw secret keys for dual URI/inline support
SECRET_KEY_VAL=$(cat /data/gitea/conf/secret_key 2>/dev/null || true)
INTERNAL_TOKEN_VAL=$(cat /data/gitea/conf/internal_token 2>/dev/null || true)
JWT_SECRET_VAL=$(cat /data/gitea/conf/jwt_secret 2>/dev/null || true)
LFS_JWT_SECRET_VAL=$(cat /data/gitea/conf/lfs_jwt_secret 2>/dev/null || true)

# Helper function to set or replace key in ini file
ini_set() {
    local section="$1"
    local key="$2"
    local value="$3"
    local file="/data/gitea/conf/app.ini"

    awk -v s="$section" -v k="$key" -v v="$value" '
    BEGIN {
        in_section = 0
        section_found = 0
        key_found = 0
    }
    /^\[.*\]/ {
        if ($0 ~ "^\\[" s "\\]") {
            in_section = 1
            section_found = 1
        } else {
            if (in_section && !key_found) {
                print k " = " v
                key_found = 1
            }
            in_section = 0
        }
        print $0
        next
    }
    {
        if (in_section && $0 ~ "^" k "[[:space:]]*=") {
            print k " = " v
            key_found = 1
            next
        }
        print $0
    }
    END {
        if (!section_found) {
            print ""
            print "[" s "]"
            print k " = " v
        } else if (in_section && !key_found) {
            print k " = " v
        }
    }
    ' "$file" > "${file}.tmp" && mv "${file}.tmp" "$file"
}

ini_set_default() {
    local section="$1"
    local key="$2"
    local value="$3"
    local file="/data/gitea/conf/app.ini"

    awk -v s="$section" -v k="$key" -v v="$value" '
    BEGIN {
        in_section = 0
        section_found = 0
        key_found = 0
    }
    /^\[.*\]/ {
        if ($0 ~ "^\\[" s "\\]") {
            in_section = 1
            section_found = 1
        } else {
            if (in_section && !key_found) {
                print k " = " v
                key_found = 1
            }
            in_section = 0
        }
        print $0
        next
    }
    {
        if (in_section && $0 ~ "^" k "[[:space:]]*=") {
            key_found = 1
        }
        print $0
    }
    END {
        if (!section_found) {
            print ""
            print "[" s "]"
            print k " = " v
        } else if (in_section && !key_found) {
            print k " = " v
        }
    }
    ' "$file" > "${file}.tmp" && mv "${file}.tmp" "$file"
}

# Setup or upgrade app.ini
if [ ! -s /data/gitea/conf/app.ini ]; then
    bashio::log.info "Creating initial Gitea configuration (app.ini)..."
    cat <<EOF > /data/gitea/conf/app.ini
APP_NAME = Gitea: Git with a cup of tea
RUN_USER = git
WORK_PATH = /data/gitea
RUN_MODE = prod

[repository]
ROOT = /data/git/repositories
DEFAULT_BRANCH = main

[server]
APP_DATA_PATH = /data/gitea/data
DOMAIN = ${DOMAIN}
SSH_DOMAIN = ${DOMAIN}
HTTP_ADDR = 127.0.0.1
HTTP_PORT = 3001
ROOT_URL = ${ROOT_URL}
DISABLE_SSH = false
START_SSH_SERVER = ${START_SSH_SERVER}
SSH_PORT = ${SSH_PORT}
SSH_LISTEN_PORT = 2222
SSH_KEYGEN_PATH = /usr/bin/ssh-keygen
SSH_ROOT_PATH = /data/git/.ssh
LFS_START_SERVER = true
LFS_JWT_SECRET_URI = file:/data/gitea/conf/lfs_jwt_secret
OFFLINE_MODE = false
ENABLE_GZIP = false

[database]
DB_TYPE = sqlite3
PATH = /data/gitea/data/gitea.db
SQLITE_JOURNAL_MODE = WAL
SQLITE_TIMEOUT = 20000

[security]
INSTALL_LOCK = true
SECRET_KEY_URI = file:/data/gitea/conf/secret_key
INTERNAL_TOKEN_URI = file:/data/gitea/conf/internal_token
PASSWORD_HASH_ALGO = argon2
PASSWORD_CHECK_PWN = ${PASSWORD_CHECK_PWN}
REVERSE_PROXY_TRUSTED_PROXIES = *
REVERSE_PROXY_LIMIT = 2
RP_ID = ${DOMAIN}
RP_ORIGIN = ${RP_ORIGIN}

[service]
DISABLE_REGISTRATION = ${DISABLE_REGISTRATION}
REQUIRE_SIGNIN_VIEW = ${REQUIRE_SIGNIN_VIEW}
REGISTER_EMAIL_CONFIRM = ${REGISTER_EMAIL_CONFIRM}
ENABLE_NOTIFY_MAIL = ${MAILER_ENABLED}
DISABLE_GRAVATAR = false
ENABLE_FEDERATED_AVATAR = false
ENABLE_CAPTCHA = ${CAPTCHA_ENABLED}
REQUIRE_CAPTCHA_FOR_LOGIN = ${CAPTCHA_FOR_LOGIN}
CAPTCHA_TYPE = ${CAPTCHA_TYPE}
RECAPTCHA_SECRET = ${RECAPTCHA_SECRET}
RECAPTCHA_SITEKEY = ${RECAPTCHA_SITEKEY}
RECAPTCHA_URL = ${RECAPTCHA_URL}
HCAPTCHA_SECRET = ${HCAPTCHA_SECRET}
HCAPTCHA_SITEKEY = ${HCAPTCHA_SITEKEY}
MCAPTCHA_SECRET = ${MCAPTCHA_SECRET}
MCAPTCHA_SITEKEY = ${MCAPTCHA_SITEKEY}
MCAPTCHA_URL = ${MCAPTCHA_URL}
CF_TURNSTILE_SECRET = ${CF_TURNSTILE_SECRET}
CF_TURNSTILE_SITEKEY = ${CF_TURNSTILE_SITEKEY}

[mailer]
ENABLED = ${MAILER_ENABLED}
PROTOCOL = ${MAILER_PROTOCOL}
SMTP_ADDR = ${MAILER_SMTP_ADDR}
SMTP_PORT = ${MAILER_SMTP_PORT}
USER = ${MAILER_USER}
PASSWD = ${MAILER_PASSWORD}
FROM = ${MAILER_FROM}
ENABLE_HELO = true
HELO_HOSTNAME = ${MAILER_HELO_HOSTNAME}
FORCE_TRUST_SERVER_CERT = ${MAILER_FORCE_TRUST_CERT}

[oauth2]
JWT_SECRET_URI = file:/data/gitea/conf/jwt_secret

[cache]
ADAPTER = memory
INTERVAL = 60

[session]
PROVIDER = memory

[log]
MODE = console
LEVEL = Info
ENABLE_ROUTER_LOG = true

[lfs]
PATH = /data/gitea/data/lfs
EOF
else
    bashio::log.info "Upgrading and synchronizing Gitea configuration (app.ini)..."
    # Remove obsolete raw keys so Gitea uses only *_URI
    sed -i '/STATIC_ROOT_PATH/d; /^SECRET_KEY =/d; /^INTERNAL_TOKEN =/d; /^JWT_SECRET =/d; /^LFS_JWT_SECRET =/d' /data/gitea/conf/app.ini

    # Synchronize template baseline defaults
    ini_set_default "repository" "ROOT" "/data/git/repositories"
    ini_set_default "repository" "DEFAULT_BRANCH" "main"

    ini_set "server" "HTTP_ADDR" "127.0.0.1"
    ini_set "server" "HTTP_PORT" "3001"
    ini_set "server" "ROOT_URL" "${ROOT_URL}"
    ini_set "server" "DOMAIN" "${DOMAIN}"
    ini_set "server" "SSH_DOMAIN" "${DOMAIN}"
    ini_set "server" "SSH_PORT" "${SSH_PORT}"
    ini_set "server" "SSH_LISTEN_PORT" "2222"
    ini_set "server" "START_SSH_SERVER" "${START_SSH_SERVER}"
    ini_set_default "server" "DISABLE_SSH" "false"
    ini_set_default "server" "SSH_KEYGEN_PATH" "/usr/bin/ssh-keygen"
    ini_set "server" "SSH_ROOT_PATH" "/data/git/.ssh"
    ini_set_default "server" "LFS_START_SERVER" "true"
    ini_set "server" "LFS_JWT_SECRET_URI" "file:/data/gitea/conf/lfs_jwt_secret"
    ini_set_default "server" "OFFLINE_MODE" "false"
    ini_set "server" "ENABLE_GZIP" "false"

    ini_set_default "database" "DB_TYPE" "sqlite3"
    ini_set_default "database" "PATH" "/data/gitea/data/gitea.db"
    ini_set "database" "SQLITE_JOURNAL_MODE" "WAL"
    ini_set "database" "SQLITE_TIMEOUT" "20000"

    ini_set_default "security" "INSTALL_LOCK" "true"
    ini_set "security" "SECRET_KEY_URI" "file:/data/gitea/conf/secret_key"
    ini_set "security" "INTERNAL_TOKEN_URI" "file:/data/gitea/conf/internal_token"
    ini_set "security" "PASSWORD_HASH_ALGO" "argon2"
    ini_set "security" "PASSWORD_CHECK_PWN" "${PASSWORD_CHECK_PWN}"
    ini_set "security" "REVERSE_PROXY_TRUSTED_PROXIES" "*"
    ini_set "security" "REVERSE_PROXY_LIMIT" "2"
    ini_set "security" "RP_ID" "${DOMAIN}"
    ini_set "security" "RP_ORIGIN" "${RP_ORIGIN}"

    ini_set "service" "DISABLE_REGISTRATION" "${DISABLE_REGISTRATION}"
    ini_set "service" "REQUIRE_SIGNIN_VIEW" "${REQUIRE_SIGNIN_VIEW}"
    ini_set "service" "REGISTER_EMAIL_CONFIRM" "${REGISTER_EMAIL_CONFIRM}"
    ini_set "service" "ENABLE_NOTIFY_MAIL" "${MAILER_ENABLED}"
    ini_set "service" "DISABLE_GRAVATAR" "false"
    ini_set "service" "ENABLE_FEDERATED_AVATAR" "false"
    ini_set "service" "ENABLE_CAPTCHA" "${CAPTCHA_ENABLED}"
    ini_set "service" "REQUIRE_CAPTCHA_FOR_LOGIN" "${CAPTCHA_FOR_LOGIN}"
    ini_set "service" "CAPTCHA_TYPE" "${CAPTCHA_TYPE}"
    ini_set "service" "RECAPTCHA_SECRET" "${RECAPTCHA_SECRET}"
    ini_set "service" "RECAPTCHA_SITEKEY" "${RECAPTCHA_SITEKEY}"
    ini_set "service" "RECAPTCHA_URL" "${RECAPTCHA_URL}"
    ini_set "service" "HCAPTCHA_SECRET" "${HCAPTCHA_SECRET}"
    ini_set "service" "HCAPTCHA_SITEKEY" "${HCAPTCHA_SITEKEY}"
    ini_set "service" "MCAPTCHA_SECRET" "${MCAPTCHA_SECRET}"
    ini_set "service" "MCAPTCHA_SITEKEY" "${MCAPTCHA_SITEKEY}"
    ini_set "service" "MCAPTCHA_URL" "${MCAPTCHA_URL}"
    ini_set "service" "CF_TURNSTILE_SECRET" "${CF_TURNSTILE_SECRET}"
    ini_set "service" "CF_TURNSTILE_SITEKEY" "${CF_TURNSTILE_SITEKEY}"

    ini_set "mailer" "ENABLED" "${MAILER_ENABLED}"
    ini_set "mailer" "PROTOCOL" "${MAILER_PROTOCOL}"
    ini_set "mailer" "SMTP_ADDR" "${MAILER_SMTP_ADDR}"
    ini_set "mailer" "SMTP_PORT" "${MAILER_SMTP_PORT}"
    ini_set "mailer" "USER" "${MAILER_USER}"
    ini_set "mailer" "PASSWD" "${MAILER_PASSWORD}"
    ini_set "mailer" "FROM" "${MAILER_FROM}"
    ini_set_default "mailer" "ENABLE_HELO" "true"
    ini_set "mailer" "HELO_HOSTNAME" "${MAILER_HELO_HOSTNAME}"
    ini_set "mailer" "FORCE_TRUST_SERVER_CERT" "${MAILER_FORCE_TRUST_CERT}"

    ini_set "oauth2" "JWT_SECRET_URI" "file:/data/gitea/conf/jwt_secret"

    ini_set_default "cache" "ADAPTER" "memory"
    ini_set_default "cache" "INTERVAL" "60"

    ini_set_default "session" "PROVIDER" "memory"

    ini_set_default "log" "MODE" "console"
    ini_set_default "log" "LEVEL" "Info"
    ini_set "log" "ENABLE_ROUTER_LOG" "true"

    ini_set_default "lfs" "PATH" "/data/gitea/data/lfs"
fi

# Secure sensitive configuration and SSH keys
chmod 640 /data/gitea/conf/app.ini 2>/dev/null || true
chmod 600 /data/gitea/conf/secret_key /data/gitea/conf/internal_token /data/gitea/conf/jwt_secret /data/gitea/conf/lfs_jwt_secret 2>/dev/null || true
chmod 700 /data/git/.ssh /data/gitea/ssh 2>/dev/null || true
find /data/git/.ssh /data/gitea/ssh -type f -name "*_key" -exec chmod 600 {} + 2>/dev/null || true

# Ensure all Gitea data is owned by git:git
chown -R git:git /data/gitea /data/git /app/gitea 2>/dev/null || true

# Initialize / migrate database schema to ensure all tables exist
bashio::log.info "Initializing / updating Gitea database schema..."
su-exec git /usr/bin/gitea migrate -c /data/gitea/conf/app.ini --work-path /data/gitea 2>&1 || true

# Ensure SQLite database runs in WAL mode with normal sync for high performance
if [ -f /data/gitea/data/gitea.db ]; then
    sqlite3 /data/gitea/data/gitea.db "PRAGMA journal_mode=WAL; PRAGMA synchronous=NORMAL;" 2>/dev/null || true
fi

# Run Gitea doctor check to display diagnostics in logs (experimental stage)
bashio::log.info "Running Gitea doctor diagnostics..."
su-exec git /usr/bin/gitea doctor check --all -c /data/gitea/conf/app.ini --work-path /data/gitea 2>&1 || true

# Configure Direct Web SSL if enabled
if bashio::config.true 'ssl' && ! bashio::config.true 'use_nginx'; then
    CERT_FILE="/ssl/$(bashio::config 'certfile')"
    KEY_FILE="/ssl/$(bashio::config 'keyfile')"
    if [ ! -f "${CERT_FILE}" ]; then
        bashio::exit.nok "Certificate file ${CERT_FILE} does not exist!"
    fi
    if [ ! -f "${KEY_FILE}" ]; then
        bashio::exit.nok "Key file ${KEY_FILE} does not exist!"
    fi
    DIRECT_LISTEN="listen 3000 ssl;
    http2 on;
    ssl_certificate ${CERT_FILE};
    ssl_certificate_key ${KEY_FILE};"
else
    DIRECT_LISTEN="listen 3000;"
fi

# Ensure Nginx runs properly without permission drops
sed -i 's/^user .*/user root;/' /etc/nginx/nginx.conf 2>/dev/null || true

# Configure internal NGINX for Ingress (8099) and Direct/Custom Domain (3000)
rm -f /etc/nginx/http.d/default.conf 2>/dev/null || true
cat <<EOF > /etc/nginx/http.d/gitea.conf
# Upstream definition with persistent keepalive connections
upstream gitea_backend {
    server 127.0.0.1:3001;
    keepalive 64;
}

# WebSocket upgrade mapping with unique variable name
map \$http_upgrade \$gitea_connection_upgrade {
    default upgrade;
    ''      '';
}

# Direct access scheme and host mappings
map \$http_x_forwarded_proto \$direct_proto {
    default \$http_x_forwarded_proto;
    ''      \$scheme;
}

map \$http_x_forwarded_host \$direct_host {
    default \$http_x_forwarded_host;
    ''      \$host;
}

# Home Assistant Ingress endpoint
server {
    listen 8099 default_server;

    absolute_redirect off;
    port_in_redirect off;

    allow 127.0.0.1;
    allow 172.30.32.2;
    deny all;

    client_max_body_size 512M;
    proxy_buffer_size 128k;
    proxy_buffers 16 256k;
    proxy_busy_buffers_size 512k;
    proxy_temp_file_write_size 512k;

    location / {
        proxy_pass http://gitea_backend;
        proxy_http_version 1.1;

        proxy_set_header Accept-Encoding "";
        proxy_set_header If-None-Match "";
        proxy_set_header If-Modified-Since "";
        proxy_set_header Host \$host;
        proxy_set_header X-Forwarded-Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$gitea_connection_upgrade;

        proxy_hide_header ETag;
        proxy_hide_header Last-Modified;
        proxy_ignore_headers Cache-Control Expires;

        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;

        sub_filter_once off;
        sub_filter_types *;
        sub_filter_last_modified on;

        # Runtime Ingress bootstrap interceptor injected in HTML head
        sub_filter '<head>' '<head><script>(function(){var p="\$http_x_ingress_path";if(!p)return;function pc(){if(window.config){window.config.appSubUrl=p;window.config.assetUrlPrefix=p+"/assets";window.config.staticUrlPrefix=p;window.config.customUrlPrefix=p+"/custom";if(window.config.sharedWorkerUri&&typeof window.config.sharedWorkerUri==="string"){window.config.sharedWorkerUri=rw(window.config.sharedWorkerUri);}}}pc();function rw(u){if(typeof u!=="string"||u.indexOf(p)===0)return u;if(u.indexOf("/assets/")===0||u.indexOf("/-/")===0||u.indexOf("/api/")===0||u.indexOf("/user/")===0||u.indexOf("/repo/")===0||u.indexOf("/org/")===0||u.indexOf("/admin/")===0||u.indexOf("/notifications")===0||u.indexOf("/explore/")===0){return p+u;}var o=window.location.origin;if(u.indexOf(o+"/assets/")===0||u.indexOf(o+"/-/")===0||u.indexOf(o+"/api/")===0){return u.replace(o,o+p);}return u;}var oc=document.createElement;document.createElement=function(t,o){var e=oc.call(document,t,o);var s=String(t).toLowerCase();if(s==="script"||s==="link"){var sa=e.setAttribute;e.setAttribute=function(n,v){if((n==="src"||n==="href")&&typeof v==="string"){v=rw(v);}return sa.call(this,n,v);};var k=s==="script"?"src":"href";var val="";Object.defineProperty(e,k,{get:function(){return e.getAttribute(k)||val;},set:function(v){v=rw(v);val=v;e.setAttribute(k,v);},configurable:true,enumerable:true});}return e;};if(window.fetch){var of=window.fetch;window.fetch=function(i,n){if(typeof i==="string"){i=rw(i);}else if(i&&i.url){i=new Request(rw(i.url),i);}return of.call(this,i,n);};}if(window.XMLHttpRequest){var oo=XMLHttpRequest.prototype.open;XMLHttpRequest.prototype.open=function(m,u){if(typeof u==="string"){u=rw(u);}var a=[m,u];for(var i=2;i<arguments.length;i++){a.push(arguments[i]);}return oo.apply(this,a);};}if(window.SharedWorker){var osw=window.SharedWorker;window.SharedWorker=function(u,o){pc();return new osw(rw(u),o);};window.SharedWorker.prototype=osw.prototype;}if(window.Worker){var ow=window.Worker;window.Worker=function(u,o){return new ow(rw(u),o);};window.Worker.prototype=ow.prototype;}if(window.EventSource){var oes=window.EventSource;window.EventSource=function(u,c){return new oes(rw(u),c);};window.EventSource.prototype=oes.prototype;}window.addEventListener("DOMContentLoaded",pc);})();</script>';
        sub_filter 'http://\$http_host/' '\$http_x_ingress_path/';
        sub_filter 'https://\$http_host/' '\$http_x_ingress_path/';
        sub_filter 'http://\$host:8099/' '\$http_x_ingress_path/';
        sub_filter 'https://\$host:8099/' '\$http_x_ingress_path/';
        sub_filter 'http://\$host/' '\$http_x_ingress_path/';
        sub_filter 'https://\$host/' '\$http_x_ingress_path/';
        sub_filter 'http://${DOMAIN}:${WEB_PORT}/' '\$http_x_ingress_path/';
        sub_filter 'https://${DOMAIN}:${WEB_PORT}/' '\$http_x_ingress_path/';
        sub_filter 'http://${DOMAIN}:${WEB_PORT}' '\$http_x_ingress_path';
        sub_filter 'https://${DOMAIN}:${WEB_PORT}' '\$http_x_ingress_path';
        sub_filter 'http://${DOMAIN}/' '\$http_x_ingress_path/';
        sub_filter 'https://${DOMAIN}/' '\$http_x_ingress_path/';
        sub_filter 'http://${DOMAIN}' '\$http_x_ingress_path';
        sub_filter 'https://${DOMAIN}' '\$http_x_ingress_path';
        sub_filter '${ROOT_URL}' '\$http_x_ingress_path/';
        sub_filter '${ROOT_URL%/}' '\$http_x_ingress_path';

        # HTML element attributes
        sub_filter 'href="/assets/' 'href="\$http_x_ingress_path/assets/';
        sub_filter 'src="/assets/' 'src="\$http_x_ingress_path/assets/';
        sub_filter 'action="/assets/' 'action="\$http_x_ingress_path/assets/';
        sub_filter 'content="/assets/' 'content="\$http_x_ingress_path/assets/';
        sub_filter 'href="/' 'href="\$http_x_ingress_path/';
        sub_filter 'src="/' 'src="\$http_x_ingress_path/';
        sub_filter 'action="/' 'action="\$http_x_ingress_path/';
        sub_filter 'formaction="/' 'formaction="\$http_x_ingress_path/';
        sub_filter 'data-url="/' 'data-url="\$http_x_ingress_path/';
        sub_filter 'data-link="/' 'data-link="\$http_x_ingress_path/';
        sub_filter 'data-src="/' 'data-src="\$http_x_ingress_path/';
        sub_filter 'data-href="/' 'data-href="\$http_x_ingress_path/';
        sub_filter 'data-action="/' 'data-action="\$http_x_ingress_path/';
        sub_filter 'data-fetch-url="/' 'data-fetch-url="\$http_x_ingress_path/';
        sub_filter 'data-preview-url="/' 'data-preview-url="\$http_x_ingress_path/';
        sub_filter 'data-query-url="/' 'data-query-url="\$http_x_ingress_path/';

        # HTMX attributes
        sub_filter 'hx-get="/' 'hx-get="\$http_x_ingress_path/';
        sub_filter 'hx-post="/' 'hx-post="\$http_x_ingress_path/';
        sub_filter 'hx-delete="/' 'hx-delete="\$http_x_ingress_path/';
        sub_filter 'hx-put="/' 'hx-put="\$http_x_ingress_path/';
        sub_filter 'hx-patch="/' 'hx-patch="\$http_x_ingress_path/';
        sub_filter 'hx-push-url="/' 'hx-push-url="\$http_x_ingress_path/';
        sub_filter 'hx-target="/' 'hx-target="\$http_x_ingress_path/';
        sub_filter 'hx-indicator="/' 'hx-indicator="\$http_x_ingress_path/';

        # CSS asset references
        sub_filter 'url(/assets/' 'url(\$http_x_ingress_path/assets/';
        sub_filter 'url("/assets/' 'url("\$http_x_ingress_path/assets/';
        sub_filter "url('/assets/" "url('\$http_x_ingress_path/assets/";
        sub_filter 'url(/custom/' 'url(\$http_x_ingress_path/custom/';
        sub_filter 'url("/custom/' 'url("\$http_x_ingress_path/custom/';
        sub_filter "url('/custom/" "url('\$http_x_ingress_path/custom/";

        # Static assets and custom path JS strings
        sub_filter '"/assets/"' '"\$http_x_ingress_path/assets/"';
        sub_filter "'/assets/'" "'\$http_x_ingress_path/assets/'";
        sub_filter '"/assets/' '"\$http_x_ingress_path/assets/';
        sub_filter "'/assets/" "'\$http_x_ingress_path/assets/";
        sub_filter '"/assets"' '"\$http_x_ingress_path/assets"';
        sub_filter "'/assets'" "'\$http_x_ingress_path/assets'";
        sub_filter '"/custom/"' '"\$http_x_ingress_path/custom/"';
        sub_filter "'/custom/'" "'\$http_x_ingress_path/custom/'";
        sub_filter '"/custom/' '"\$http_x_ingress_path/custom/';
        sub_filter "'/custom/" "'\$http_x_ingress_path/custom/";
        sub_filter '"/custom"' '"\$http_x_ingress_path/custom"';
        sub_filter "'/custom'" "'\$http_x_ingress_path/custom'";

        # Internal routes and API endpoints in JS
        sub_filter '"/-/' '"\$http_x_ingress_path/-/';
        sub_filter "'/-/'" "'\$http_x_ingress_path/-/'";
        sub_filter '"/user/' '"\$http_x_ingress_path/user/';
        sub_filter "'/user/'" "'\$http_x_ingress_path/user/'";
        sub_filter '"/repo/' '"\$http_x_ingress_path/repo/';
        sub_filter "'/repo/'" "'\$http_x_ingress_path/repo/'";
        sub_filter '"/api/' '"\$http_x_ingress_path/api/';
        sub_filter "'/api/'" "'\$http_x_ingress_path/api/'";
        sub_filter '"/avatar/' '"\$http_x_ingress_path/avatar/';
        sub_filter "'/avatar/'" "'\$http_x_ingress_path/avatar/'";
        sub_filter '"/org/' '"\$http_x_ingress_path/org/';
        sub_filter "'/org/'" "'\$http_x_ingress_path/org/'";
        sub_filter '"/admin/' '"\$http_x_ingress_path/admin/';
        sub_filter "'/admin/'" "'\$http_x_ingress_path/admin/'";
        sub_filter '"/notifications"' '"\$http_x_ingress_path/notifications"';
        sub_filter "'/notifications'" "'\$http_x_ingress_path/notifications'";
        sub_filter '"/explore/' '"\$http_x_ingress_path/explore/';
        sub_filter "'/explore/'" "'\$http_x_ingress_path/explore/'";

        # Gitea window.config frontend variables
        sub_filter 'appSubUrl: ""' 'appSubUrl: "\$http_x_ingress_path"';
        sub_filter "appSubUrl: ''" "appSubUrl: '\$http_x_ingress_path'";
        sub_filter 'AppSubUrl: ""' 'AppSubUrl: "\$http_x_ingress_path"';
